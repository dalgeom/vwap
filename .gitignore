# 보안
.env
*.key
*.pem

# Python 자동 생성 (양쪽 PC에서 재생성됨)
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 백테스트/분석 캐시 (대용량, API로 재생성 가능)
vwap_trader/data/backtest_cache/
vwap_trader/data/cache/*.json

# 런타임 파일 (봇이 자동 생성)
vwap_trader/data/heartbeat
vwap_trader/data/heartbeat_momentum
vwap_trader/data/slippage.jsonl
vwap_trader/logs/

# 데이터 백업 (로컬 전용 — A-3 무결성 가드가 봇 시작 시 생성, 로컬 복구용)
vwap_trader/data/*.bak_*

# 정본 스냅샷 (파생물 — build_canonical.py로 언제든 재생성)
vwap_trader/data/trades_canonical.jsonl

# B-2 지연진입 백테스트 1분봉 캐시 (파생물 — 재조회로 재생성)
vwap_trader/data/_bt_delayed_klines_cache.json

# Claude Code 로컬 설정 (머신별 권한 목록 — PC마다 자동 수정되어 pull 충돌 유발)
.claude/settings.local.json
vwap_trader/data/_mr_1h_cache.json
vwap_trader/data/_mr_1m_cache.json
vwap_trader/data/_fund_hist_cache.json
vwap_trader/data/_crowd_cache.json
vwap_trader/data/_xcrowd_lsr.json
vwap_trader/data/_xcrowd_daily_px.json
